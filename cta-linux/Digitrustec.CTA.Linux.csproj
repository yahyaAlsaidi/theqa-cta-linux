<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- Linux host for Digitrustec CTA. Reuses the installed Windows CTA's portable assemblies unchanged;
       only Digitrustec.CTA.Win.dll (WPF + Win32) is replaced, by Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <CtaDir Condition="'$(CtaDir)' == ''">$(HOME)/.wine-theqa/drive_c/users/$(USER)/AppData/Local/Digitrustec.CTA.Win</CtaDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(CtaDir)/Digitrustec.CTA.*.dll" Exclude="$(CtaDir)/Digitrustec.CTA.Win.dll" />
    <Reference Include="$(CtaDir)/OmanIDCard.CrossPlatform.dll" />
    <Content Include="$(CtaDir)/ChainCertificates/*.cer" Link="ChainCertificates/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="appicon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Same versions as Digitrustec.CTA.Win.deps.json -->
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="PCSC" Version="7.0.1" />
    <PackageReference Include="Pkcs11Interop" Version="5.2.0" />
    <PackageReference Include="Portable.BouncyCastle" Version="1.9.0" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
  </ItemGroup>

  <!-- Report the same version as the Windows CTA the assemblies came from (the page and server check it). -->
  <Target Name="CtaVersion" BeforeTargets="GetAssemblyVersion">
    <GetAssemblyIdentity AssemblyFiles="$(CtaDir)/Digitrustec.CTA.Win.dll">
      <Output TaskParameter="Assemblies" ItemName="_CtaWin" />
    </GetAssemblyIdentity>
    <PropertyGroup>
      <Version>%(_CtaWin.Version)</Version>
    </PropertyGroup>
  </Target>
</Project>
